# URL del backend FastAPI. En el emulador de Android, 10.0.2.2 apunta al
# localhost de tu PC. En un móvil físico, usa la IP local de tu PC
# (por ejemplo http://192.168.1.35:8000) — el móvil y el PC deben estar
# en la misma red WiFi.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# API key de Google Maps para Android (Maps SDK for Android). Obligatoria en
# builds nativos (`npx expo run:android`, EAS); en Expo Go no hace falta.
# Tras cambiarla, regenera el proyecto nativo: npx expo prebuild --platform android
GOOGLE_MAPS_API_KEY=

# URL del backend cuando la app se abre en el navegador (`npm run web`).
# Por defecto http://localhost:8000 (el de `python run.py --render`).
# EXPO_PUBLIC_WEB_API_URL=http://localhost:8000
